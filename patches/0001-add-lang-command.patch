+ def setLanguages(self, data):
+  values = bytearray(self._parseHexData(data))
+  base, n = 0x010d008f, 35
+  if len(values) != n:
+   raise Exception('Need exactly %d bytes, got %d' % (n, len(values)))
+  bad = [v for v in values if v not in (1, 2)]
+  if bad:
+   raise Exception('Bytes must be 01 or 02, got %r' % bad)
+  patch = BackupPatchDataInterface(self.backend)
+  for i, v in enumerate(values):
+   patch.writeProp(base + i, bytes(bytearray([v])))
+  patch.apply()
+  print('Success: %d/%d languages enabled' % (sum(1 for v in values if v == 1), n))
+
  def syncBackup(self):
   self.backend.syncBackup()
 
